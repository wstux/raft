# Common
MODULE_NAME = @MODULE_NAME@
CC = gcc -Wall
INC = -I/usr/src/linux-headers-$(shell uname -r)/include
KERNEL_SRC := /lib/modules/$(shell uname -r)/build
SRC_DIR := @MODULE_SRC_ROOT_DIR@
BUILD_DIR := @MODULE_BUILD_DIR@

# Calculate the relative path from BUILD_DIR to SRC_DIR
# (kbuild will perform the build while inside BUILD_DIR)
REL_SRC_DIR := $(shell realpath --relative-to=$(BUILD_DIR) $(SRC_DIR))

@MODULE_INCLUDE_DIRS@
@MODULE_EXTRA_CFLAGS@
@MODULE_EXTRA_LDFLAGS@
@MODULE_COMPILE_DIFS@

# Get sources from src directory
SOURCES := @MODULE_SOURCE_FILES@
MODULE_OBJS := $(SOURCES:.c=.o) # Explicitly list object files relative to the root of the assembly
$(MODULE_NAME)-objs := $(addprefix $(REL_SRC_DIR)/, $(MODULE_OBJS)) # Add a relative path to each file from the list

obj-m := $(MODULE_NAME).o

all: PREPARE
	$(MAKE) -C $(KERNEL_SRC) M=$(BUILD_DIR) src=$(SRC_DIR) modules

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(BUILD_DIR) src=$(SRC_DIR) clean
	rm -rf $(BUILD_DIR)

install:
	$(MAKE) -C $(KERNEL_SRC) M=$(BUILD_DIR) src=$(SRC_DIR) modules_install

PREPARE: $(SOURCES)
	mkdir -p "$(BUILD_DIR)"
	@MODULE_MAKE_SUB_DIRS@
	touch $(BUILD_DIR)/Makefile
